# Discord
TOKEN=put_your_discord_bot_token_here
# 0 = global commands; set a server ID for instant development command registration
COMMAND_GUILD_ID=0

# SQLite (the Docker volume is mounted at /app/data)
DATABASE_PATH=data/zenithbeep.db

# Music / Lavalink
AUDIO_SERVICES=false
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass

# Optional HTTP proxy. Proxy is ignored unless explicitly enabled.
PROXY_ENABLED=false
HTTP_PROXY=http://172.17.0.1:2081
HTTPS_PROXY=http://172.17.0.1:2081
